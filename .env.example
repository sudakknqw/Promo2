# Supabase project URL (not a secret). SUPABASE_URL also works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram notifications (server only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string (A-Z a-z 0-9 _ -, up to 256 chars). Must match secret_token in setWebhook.
TELEGRAM_WEBHOOK_SECRET=
